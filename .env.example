# Teltonika Telematics Suite Configuration

# TCP Server Port for GPS Trackers (FMX150, FMB150, FMC150, etc.)
TCP_PORT=5023

# HTTP & WebSocket Port for REST API and Web Dashboard
HTTP_PORT=3001

# Database Configuration (sqlite or mysql)
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/telematics.db

# Security & CORS
CORS_ORIGIN=*

# Fuel Alert Settings (Defaults)
DEFAULT_THEFT_THRESHOLD_LITERS=5.0
DEFAULT_THEFT_WINDOW_MINUTES=10
DEFAULT_REFUEL_THRESHOLD_LITERS=10.0
